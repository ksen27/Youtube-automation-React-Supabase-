FROM node:20-bookworm-slim

# ffmpeg + yt-dlp + redis. Redis runs in the same container as the worker
# so we don't pay for a separate Upstash plan or Fly Redis VM. State is
# written to /data which is a Fly volume — survives container restarts.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    python3 \
    ca-certificates \
    curl \
    unzip \
    redis-server \
    fonts-dejavu-core \
 && curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp \
      -o /usr/local/bin/yt-dlp \
 && chmod +x /usr/local/bin/yt-dlp \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Deno — the JS runtime yt-dlp uses to solve YouTube's player challenge.
#
# NOT optional, despite yt-dlp only WARNING about it: without a JS runtime
# YouTube rejects the request as a bot ("Sign in to confirm you're not a bot")
# no matter how clean the source IP is, so residential proxies alone do not fix
# it. yt-dlp has deprecated JS-less extraction; the warning is the cause, not
# noise. Installed to a fixed path and pointed at explicitly via
# YT_DLP_DENO_PATH (see fly.ebook.toml) rather than relying on PATH.
#
# Used by the ebook worker's Whisper audio fallback. Harmless on the video
# workers, which share this image — yt-dlp there picks it up on PATH too, which
# only makes their downloads more reliable.
RUN curl -fsSL https://deno.land/install.sh | DENO_INSTALL=/usr/local sh -s -- -y \
 && /usr/local/bin/deno --version

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev=false

# Chromium + its OS deps for the synthetic engine's HeyGen avatar automation
# (Playwright). --with-deps installs the system libraries Chromium needs on
# Debian slim. Browsers land under /root/.cache/ms-playwright by default.
RUN npx playwright install --with-deps chromium

# patchright (stealth-patched Chromium) for HEYGEN_USE_STEALTH=true — it ships
# its OWN patched Chromium build, so it must be installed separately from the
# Playwright one above. The OS deps are already present from --with-deps, so a
# plain `install chromium` (no --with-deps) suffices here.
RUN npx patchright install chromium

# Puppeteer's OWN Chromium, for the ebook worker (WORKER_ROLE=ebook): the PDF
# exporter and the landing-page template capturer call puppeteer.launch() with
# no executablePath, so they need the browser Puppeteer downloads for itself —
# the Playwright/patchright builds above are not interchangeable with it.
#
# PUPPETEER_CACHE_DIR is pinned so the install location is deterministic and
# matches what fly.ebook.toml sets at runtime; the default (~/.cache/puppeteer)
# is HOME-dependent, and a mismatch surfaces only when an export first runs, as
# "Could not find Chrome". One image serves all three worker roles, so this is
# installed unconditionally — the video workers simply never launch it.
ENV PUPPETEER_CACHE_DIR=/root/.cache/puppeteer
RUN npx puppeteer browsers install chrome

COPY . .

# AOF (appendonly) keeps queue state durable across restarts; noeviction is
# required for BullMQ (silent eviction would lose in-flight jobs). REDIS_URL
# is set as a Fly secret (must include the password and the public Fly host).
ENV NODE_ENV=production \
    FFMPEG_PATH=ffmpeg \
    FFPROBE_PATH=ffprobe \
    YTDLP_PATH=yt-dlp \
    TMP_DIR=/tmp/work

# Start Redis as a daemon, then exec the worker as PID 1 so SIGTERM from
# Fly reaches the worker and triggers its graceful shutdown handler.
# --bind 0.0.0.0 lets the Vercel app reach Redis over the public internet
# (port exposed via fly.toml [[services]]). --requirepass enforces auth.
# Password is read at runtime from REDIS_PASSWORD env (Fly secret).
#
# Redis is started ONLY on the celebrity worker, which is the app that hosts it
# (fly.toml exposes port 6379 and mounts the AOF volume). The avatar and ebook
# workers are pure CONSUMERS of that instance and must not run one: a local
# Redis there is not just wasted memory, it is a hazard — if REDIS_URL were ever
# misconfigured to localhost, the worker would connect to an empty local queue,
# find no jobs, and look "healthy" while the real queue silently backed up.
#
# Gated on WORKER_ROLE rather than on REDIS_PASSWORD: the role is declared in
# each app's [env] and is the thing that actually distinguishes them, whereas a
# stray password secret on a consumer app would silently start a second Redis.
# 'sourced' and 'all' both host it; 'synthetic' and 'ebook' never do. Defaults
# to starting Redis when WORKER_ROLE is unset, which is the local/dev case.
CMD mkdir -p /data \
 && if [ "$WORKER_ROLE" = "sourced" ] || [ "$WORKER_ROLE" = "all" ] || [ -z "$WORKER_ROLE" ]; then \
      redis-server --daemonize yes \
        --dir /data \
        --appendonly yes \
        --maxmemory-policy noeviction \
        --bind 0.0.0.0 \
        --protected-mode no \
        --requirepass "$REDIS_PASSWORD"; \
    fi \
 && exec npx tsx worker/index.ts
