# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local heygen debug test audio (staged file for scripts/heygen-debug-gen.ts)
/slice.mp3

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# project: working directory for downloads / clip cuts before upload
/tmp/

# HeyGen automation runtime diagnostics (screenshots, HTML, json snapshots)
/logs/heygen/

# Payhip automation: browser session state and failure diagnostics.
#
# The session is a BEARER CREDENTIAL — anyone holding it is logged into the
# seller's store — and it normally never touches the disk at all: it lives
# encrypted in the database (see supabase/migrations/0034_payhip_session.sql).
# These patterns exist for the local-debugging case, where a stray
# storage_state.json or a debug screenshot of a logged-in dashboard would
# otherwise be one `git add -A` away from being published.
/logs/payhip/
payhip-debug/
**/payhip-storage-state*.json
**/storage_state*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Throwaway output from scripts/celeb-image-spike.ts
scripts/.spike-out/

# Local clip-quality comparison output (scripts/clip-quality-sample.ts)
clip-quality-sample/

# Local archives (too large for GitHub)
*.rar
feedback.txt
