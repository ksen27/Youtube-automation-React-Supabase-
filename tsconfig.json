{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@ebook/core": ["./packages/ebook-core/index.ts"],
      "@ebook/core/*": ["./packages/ebook-core/*"],
      "@ebook/infra": ["./packages/ebook-infra/index.ts"],
      "@ebook/infra/*": ["./packages/ebook-infra/*"],
      "@ebook/config": ["./packages/ebook-config/index.ts"],
      "@ebook/config/*": ["./packages/ebook-config/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
